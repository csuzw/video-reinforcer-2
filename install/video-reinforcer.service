[Unit]
Description=Video Reinforcer
# Start after the local filesystem and udev are ready
After=local-fs.target udev.service
Wants=udev.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/video-reinforcer
ExecStartPre=-/bin/sh -c 'printf "\033[?25l" > /dev/tty1 2>/dev/null; printf "\033[?25l" > /dev/tty2 2>/dev/null'
ExecStart=/opt/video-reinforcer/venv/bin/python3 -m src.main
Restart=on-failure
RestartSec=5
# Give mpv time to claim DRM connectors on restart
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
