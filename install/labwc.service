[Unit]
Description=labwc Wayland compositor (Video Reinforcer kiosk)
# Plymouth (boot splash) holds DRM master until it quits; starting before it
# releases causes "Device or resource busy" and labwc never gets master.
# This is the same ordering display managers (lightdm, gdm, etc.) use.
After=local-fs.target udev.service seatd.service plymouth-quit.service
Wants=udev.service seatd.service
# Conflicts= alone does not order the handoff — without Before=, systemd may
# start the display manager while labwc is still releasing DRM master,
# producing a black screen instead of the restored desktop on quit. Before=
# guarantees labwc's shutdown is ordered ahead of the display manager's startup.
Conflicts=lightdm.service gdm.service gdm3.service sddm.service xdm.service lxdm.service
Before=lightdm.service gdm.service gdm3.service sddm.service xdm.service lxdm.service

[Service]
Type=simple
User=root
# XDG_RUNTIME_DIR is created by RuntimeDirectory= below
Environment=XDG_RUNTIME_DIR=/run/labwc
Environment=WAYLAND_DISPLAY=wayland-0
Environment=WLR_BACKENDS=drm
# WLR_DRM_DEVICES is set by labwc-start.sh: it picks the vc4 display
# controller (the card with HDMI connectors). The card number is not stable
# across boots on a Pi 4, so it must not be hard-coded here.
# libliftoff for DRM plane allocation (required on Pi 5, harmless on Pi 4)
Environment=WLR_DRM_FORCE_LIBLIFTOFF=1
# Keep compositor running even with no physical outputs connected
Environment=LABWC_FALLBACK_OUTPUT=NOOP-1
# Use seatd for seat management (bypasses logind session requirement).
# The logind backend times out when labwc runs as a systemd service with
# no active logind session; seatd has no such constraint.
Environment=LIBSEAT_BACKEND=seatd
RuntimeDirectory=labwc
RuntimeDirectoryMode=0755
ExecStart=/opt/video-reinforcer/labwc-start.sh -C /opt/video-reinforcer/labwc
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
